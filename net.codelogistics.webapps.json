{
    "app-id": "net.codelogistics.webapps",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "webapps",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-data"
    ],
    "modules": [
        {
            "name": "webapps",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/eyekay/webapps.git",
                    "tag": "0.6.0",
                    "commit": "7482f2c5efd09d2720d08daba43b495c0546f6f1",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
